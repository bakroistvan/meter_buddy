# HTTPS on host METER_BUDDY_HTTPS_PORT (default 9111).
# Certs via Let's Encrypt DNS-01 (DuckDNS) — no port 80 required.
# Listen on 9111 inside the container (compose maps host port → 9111) so
# http_redirect can catch plain HTTP on the same port and 308 to https://.
{
	https_port 9111
	auto_https disable_redirects

	servers {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

{$METER_BUDDY_DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}
	reverse_proxy backend:8000
}
