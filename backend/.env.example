# Copy to .env and edit (never commit .env):
#   cp .env.example .env
#
# Docker Compose loads .env for ${VAR} substitution and injects it via env_file.

# DuckDNS hostname (create at https://www.duckdns.org/ ).
METER_BUDDY_DOMAIN=changeme.duckdns.org

# DuckDNS token (Account → token on duckdns.org). Used for Let's Encrypt DNS-01.
DUCKDNS_TOKEN=replace-with-your-duckdns-token

# Host HTTPS port (router should forward WAN TCP this port → host:port).
# Clients / firmware: https://DOMAIN:PORT/...
METER_BUDDY_HTTPS_PORT=9111

# HTTP Basic Auth (password must not be empty or "change-me").
METER_BUDDY_AUTH_USER=meter-buddy
METER_BUDDY_AUTH_PASSWORD=replace-with-a-strong-secret

# SQLite path inside the backend container (matches the /data volume).
METER_BUDDY_DB_PATH=/data/meter_buddy.sqlite3
